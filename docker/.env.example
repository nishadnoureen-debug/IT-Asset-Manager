# Copy to docker/.env and fill in. Never commit the real file.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   # JWT_ACCESS_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      # ENCRYPTION_KEY

POSTGRES_USER=itam
POSTGRES_PASSWORD=change-me
POSTGRES_DB=itam

JWT_ACCESS_SECRET=
ENCRYPTION_KEY=

# The URL people use to open the app (used in QR labels and reset links).
PUBLIC_WEB_URL=http://localhost:3000
WEB_PORT=3000

# local = files on the "storage" volume; s3 = any S3-compatible store (AWS S3, MinIO, Wasabi…)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
