# Copy to apps/api/.env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000

# PostgreSQL — user/pass itam, db itam.
#   docker compose (npm run db:up):          port 5432
#   project-local server (npm run db:local): port 5433
DATABASE_URL=postgresql://itam:itam@localhost:5432/itam?schema=public

# Browser origins allowed to call the API directly (the web app normally proxies instead).
CORS_ORIGINS=http://localhost:3000
# Express "trust proxy": which proxies may set X-Forwarded-For (loopback = the local Next.js server).
TRUST_PROXY=loopback

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Global rate limit per client IP: THROTTLE_LIMIT requests per THROTTLE_TTL_MS window
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=600

# Swagger UI at /api/docs (always off in production)
ENABLE_SWAGGER=true
# Daily warranty / licence / overdue / maintenance alerts
ENABLE_SCHEDULER=true

# ── Authentication ──────────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# 32 bytes, base64 — encrypts licence keys. Back it up: without it stored keys cannot be read.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Public URL of the web app (QR labels and password-reset links point here)
PUBLIC_WEB_URL=http://localhost:3000

# Optional: owner of a new install. While no Super Admin exists only this email can register (and becomes
# the Super Admin); registration then closes. Recommended whenever the site is reachable from the internet.
BOOTSTRAP_ADMIN_EMAIL=

# ── File storage ────────────────────────────────────────────────────────────
# local = files under STORAGE_LOCAL_DIR; s3 = any S3-compatible store; database = inside PostgreSQL
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=10485760
