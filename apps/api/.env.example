# Copy to apps/api/.env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000

# PostgreSQL — user/pass itam, db itam.
#   docker compose (npm run db:up):          port 5432
#   project-local server (npm run db:local): port 5433
DATABASE_URL=postgresql://itam:itam@localhost:5432/itam?schema=public

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_MS window
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Expose Swagger UI at /api/docs (forced off in production)
ENABLE_SWAGGER=true
