# Copy to apps/web/.env.local. Public variables are embedded into the browser bundle — no secrets here.
# Browser calls go to /api/v1 on this origin; Next.js proxies them to the API.
NEXT_PUBLIC_API_URL=/api/v1
# Where the Next.js server forwards /api/v1 (server-side only). In Docker: http://api:4000
API_INTERNAL_URL=http://localhost:4000
